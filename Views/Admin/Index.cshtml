@model IEnumerable<ApplicationUser>
@{
    ViewData["Title"] = "Admin";
}

<h1>Users</h1>
<table class="table">
    <thead>
        <tr><th>Email</th><th>Actions</th></tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td><a asp-action="Edit" asp-route-id="@user.Id">Edit</a></td>
            </tr>
        }
    </tbody>
</table>
