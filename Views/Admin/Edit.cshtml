@model EditUserViewModel
@{
    ViewData["Title"] = "Edit user";
}

<h1>Edit user</h1>
<p>@Model.Email</p>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="col-md-5 px-0">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="Role"></label>
        <select asp-for="Role" class="form-control">
            <option value="Admin">Admin</option>
            <option value="Buyer">Buyer</option>
        </select>
        <span asp-validation-for="Role" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="BuyerType"></label>
        <select asp-for="BuyerType" class="form-control">
            <option value="@BuyerTypes.None">None</option>
            <option value="@BuyerTypes.Regular">Regular</option>
            <option value="@BuyerTypes.Golden">Golden</option>
            <option value="@BuyerTypes.Wholesale">Wholesale</option>
        </select>
        <span asp-validation-for="BuyerType" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="CustomerId"></label>
        <select asp-for="CustomerId" asp-items="@(ViewData["Customers"] as SelectList)" class="form-control">
            <option value="">No customer linked</option>
        </select>
        <small class="form-text text-muted">A buyer can see orders for the linked customer.</small>
        <span asp-validation-for="CustomerId" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-link">Back to users</a>
</form>
